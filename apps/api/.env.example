# Node Environment
NODE_ENV=production
PORT=4000

# Database URL:
# For local zero-config SQLite: file:./dev.db
# For production PostgreSQL (Render/Railway/Neon/AWS RDS):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/bhoomi_marketplace?schema=public
DATABASE_URL=file:./dev.db

# Authentication Secrets
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_character_string
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Cryptographic Key for Aadhaar & PAN at-rest encryption (AES-256-GCM)
# Must be a 64-character hexadecimal string representing 32 bytes
ENCRYPTION_KEY=a7f8e32c91b54d6023e4f7192837465a1029384756abcdef1234567890abcdef

# Anthropic Claude API Key (for grounded LLM chatbot)
# If omitted, deterministic grounded query engine runs automatically
ANTHROPIC_API_KEY=sk-ant-api03-sample...

# OTP Provider: 'console' (dev) | 'twilio' | 'msg91' | 'smtp'
OTP_PROVIDER=console
OTP_EXPIRY_SECONDS=60
OTP_MAX_ATTEMPTS=3

# CORS Origin for Frontend
CORS_ORIGIN=https://bhoomi-marketplace.vercel.app

# Optional AWS S3 Bucket Configuration for Media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=bhoomi-property-media
